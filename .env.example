# ==================================================
# APIProof Environment Configuration Example
# Copy this file to .env and configure for your environment.
# DO NOT COMMIT SECRETS OR PRIVATE KEYS.
# ==================================================

# Environment & Server
NODE_ENV=development
PORT=5000

# Verifier & Authentication Secret
# Production (Server-Side Only - REQUIRED): Required for signing verification artifacts, provenance, and installation state tokens.
APIPROOF_SECRET=
# Optional fallback secret for authentication/session signing:
AUTH_SECRET=

# Database Configuration
# Production (Server-Side Only - REQUIRED - DO NOT expose to client, DO NOT use NEXT_PUBLIC_):
# Example: postgresql://user:password@hostname:5432/dbname?sslmode=require
APIPROOF_DATABASE_URL=

# Local-only fixture seed. Use a unique development password; never reuse a
# production credential and never commit the value itself.
APIPROOF_LOCAL_SEED_PASSWORD=

# Local SQLite Development / Testing:
# Default is ./.tmp/apiproof.db if unset.
APIPROOF_DB_PATH=./.tmp/apiproof.db

# Live GitHub App Integration
# Disabled by default. Set to true to enable live GitHub read/observe mode.
APIPROOF_ENABLE_LIVE_GITHUB=false

# Safe GitHub Draft PR Write Mode
# Disabled by default. Set to true to enable safe review-branch draft PR generation.
APIPROOF_ENABLE_LIVE_GITHUB_WRITE=false

# GitHub App Configuration (REQUIRED in Production)
GITHUB_APP_ID=
# GitHub App Slug / Name (used for installation URL, defaults to 'apiproof' if unset):
GITHUB_APP_SLUG=apiproof
# GitHub Webhook Secret (REQUIRED in Production for webhook verification):
GITHUB_WEBHOOK_SECRET=
# GitHub App Private Key:
# Production (Vercel / Cloud - REQUIRED): Supply raw PEM contents via environment variable.
# Literal newlines or escaped \n are both supported.
# Server-side only: Never expose to client-side code, never prefix with NEXT_PUBLIC_.
GITHUB_APP_PRIVATE_KEY=
# Local Development Only: Path to local .pem key file (optional if GITHUB_APP_PRIVATE_KEY is set):
GITHUB_APP_PRIVATE_KEY_PATH=

# Deprecated Fixture Configuration (Used for legacy unit test compatibility only, NOT customer authorization):
# GITHUB_INSTALLATION_ID=
# GITHUB_ALLOWED_REPOSITORY_ID=
# GITHUB_ALLOWED_REPOSITORY_OWNER=ravitejabolla756-sys
# GITHUB_ALLOWED_REPOSITORY_NAME=apiproof-github-fixture

# Internal Worker Configuration (Phase 4)
# CRON_SECRET: Required bearer token to authorize POST /api/internal/scan-worker.
# Used by Vercel Cron Jobs and any authorized internal trigger.
# REQUIRED in Production — endpoint returns 401 for all requests if unset.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Provider-intelligence beta rollout (server-side only).
# Set to exactly "true" only after the reviewed registry, release manifest,
# and live rollback checks have been completed. Any other value keeps the
# legacy scanner path active as a deliberate fail-safe.
PROVIDER_INTELLIGENCE_V1_ENABLED=false

# Canonical HTTPS origin used by the GitHub Actions provider-monitoring
# scheduler. Keep this separate from client-exposed NEXT_PUBLIC_* settings.
MY_OWL_APP_URL=

# Password reset email delivery (SMTP; server-side only)
# Required to enable password recovery. Use credentials for a dedicated transactional sender.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
PASSWORD_RESET_FROM=
# Use the canonical HTTPS production origin (or NEXT_PUBLIC_APP_URL).
APIPROOF_APP_URL=

# Google OAuth sign-in (server-side only; never prefix with NEXT_PUBLIC_).
# Production redirect is fixed to https://www.myowl.dev/api/auth/google/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://www.myowl.dev/api/auth/google/callback

# MY OWL Login GitHub OAuth App (separate from the APIProof Observe GitHub App).
# Server-side only; never prefix with NEXT_PUBLIC_.
GITHUB_LOGIN_CLIENT_ID=
GITHUB_LOGIN_CLIENT_SECRET=
GITHUB_LOGIN_REDIRECT_URI=https://www.myowl.dev/api/auth/github/callback

# Slack notifications and interactive actions (server-side only; never use NEXT_PUBLIC_).
# Configure the Slack app redirect URL as {APIPROOF_APP_URL}/api/slack/callback and its
# Interactivity Request URL as {APIPROOF_APP_URL}/api/slack/interactions.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Base64-encoded 32-byte AES-256-GCM key. Generate with a cryptographically secure
# random generator; use the same value on the web app and verification worker hosts.
SLACK_TOKEN_ENCRYPTION_KEY=
