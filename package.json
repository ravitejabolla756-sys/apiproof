{
  "name": "apiproof",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.12",
      "minimatch": "11.0.1",
      "postcss": "8.5.28",
      "source-map-js": "1.2.2"
    }
  },
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "apiproof": "tsx --conditions=apiproof-source apps/cli/src/index.ts",
    "build": "pnpm -r build",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "beta:readiness": "tsx --conditions=apiproof-source apps/web/scripts/beta-readiness.ts",
    "beta:live-preflight": "tsx --conditions=apiproof-source apps/web/scripts/beta-live-preflight.ts",
    "beta:capture-evidence": "tsx --conditions=apiproof-source apps/web/scripts/beta-capture-evidence.ts",
    "release:manifest": "tsx --conditions=apiproof-source apps/web/scripts/release-manifest.ts",
    "provider:review-report": "tsx --conditions=apiproof-source apps/web/scripts/provider-review-report.ts",
    "provider:review-pack": "tsx --conditions=apiproof-source apps/web/scripts/provider-review-pack.ts",
    "providers:validate:all": "tsx --conditions=apiproof-source apps/web/scripts/provider-validation.ts all",
    "providers:validate:multi": "tsx --conditions=apiproof-source apps/web/scripts/provider-validation.ts multi",
    "provider:seed-review-queue": "tsx --conditions=apiproof-source apps/web/scripts/seed-provider-review-queue.ts",
    "db:migrate": "pnpm --filter @apiproof/web db:migrate",
    "db:bootstrap:staging": "tsx apps/web/scripts/bootstrap-staging.ts",
    "verification:worker": "tsx apps/web/scripts/verification-worker.ts"
  },
  "devDependencies": {
    "@apiproof/analyzers": "workspace:*",
    "@apiproof/core": "workspace:*",
    "@apiproof/providers": "workspace:*",
    "@apiproof/shared": "workspace:*",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.18.0",
    "@types/semver": "^7.7.1",
    "eslint": "^10.10.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.0.18"
  }
}
